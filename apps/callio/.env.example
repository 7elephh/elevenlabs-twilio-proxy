# Callio Platform V2 — variables d'environnement
# Ne jamais committer de valeurs reelles. Copier vers .env.local.

# --- Source de donnees -----------------------------------------------------
# "demo"     : fixtures ClimaNova en memoire (aucune base requise)
# "supabase" : base Supabase reelle (exige les deux variables ci-dessous)
# Non renseigne : "demo" si Supabase n'est pas configure, sinon "supabase".
CALLIO_DATA_SOURCE=

# --- Supabase --------------------------------------------------------------
# Cle anon : publique par conception, protegee par la RLS. Jamais la service_role ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Garde-fou -------------------------------------------------------------
# Le mode demo contourne l'authentification : il est refuse en production
# sauf si cette variable vaut exactement "1". Ne jamais l'activer sur un
# deploiement accessible publiquement.
CALLIO_ALLOW_DEMO_IN_PRODUCTION=
