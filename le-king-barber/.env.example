# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : jamais côté client, jamais dans le dépôt
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Secret des liens « gérer mon rendez-vous » (>= 32 caractères) : openssl rand -base64 48
MANAGE_TOKEN_SECRET=
# Sel des empreintes IP anti-abus : openssl rand -base64 24
RATE_LIMIT_SALT=
# Protège la tâche quotidienne (rappels + purge RGPD) ; Vercel l'envoie automatiquement
CRON_SECRET=

# --- Emails transactionnels (https://resend.com) — optionnel ---
RESEND_API_KEY=
# Domaine vérifié dans Resend, ex. "Le King Barber <rdv@exemple.fr>"
EMAIL_FROM=
# Reçoit les alertes « nouvelle réservation » / « annulation client »
BARBER_NOTIFICATION_EMAIL=

# --- Google Calendar — optionnel ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 octets en base64 : openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
