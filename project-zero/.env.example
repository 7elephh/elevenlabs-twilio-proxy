# PROJECT ZERO — environment
#
# Leave these unset to run against the local file store (.data/store.json):
# the app, the seed and every page work without a Supabase project.

# --- Supabase (browser + server) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Seeding only ----------------------------------------------------------
# Service role key: server-side scripts only, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Auth user id that owns the seeded demo rows (required when seeding Supabase).
SEED_USER_ID=
